# SpotMicro RL local environment template
# Copy this file to `.env` and fill in the values below.

# Telegram bot token from BotFather.
# Example: TELEGRAM_TOKEN=1234567890:AAExampleBotTokenFromBotFather
TELEGRAM_TOKEN=

# Allowed Telegram chat id.
# For a private chat, this is usually your personal chat id.
# For a group, this is the group chat id.
# Example: TELEGRAM_CHAT_ID=123456789
TELEGRAM_CHAT_ID=

# Optional comma-separated Telegram user ids allowed to control the bot.
# Example: TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# If empty, only private chats where chat_id == user_id are accepted.
TELEGRAM_ALLOWED_USER_IDS=

# Set to 1 to include `last_error` in `status` and send detailed supervisor
# exception text to Telegram. Default 0 keeps detailed errors only in server logs.
# Example: TELEGRAM_VERBOSE_ERRORS=0
TELEGRAM_VERBOSE_ERRORS=0

# Isaac Lab task id used for training and play commands.
# Example: TASK=Isaac-Velocity-Flat-SpotMicro-v0
TASK=Isaac-Velocity-Flat-SpotMicro-v0

# Log subdirectory under logs/rsl_rl/.
# Example: LOG_SUBDIR=spot_micro_flat
LOG_SUBDIR=spot_micro_flat

# Isaac Lab launcher path on Windows.
# Example: ISAAC_LAB_PATH=C:\IsaacLab\isaaclab.bat
ISAAC_LAB_PATH=C:\IsaacLab\isaaclab.bat

# Conda environment used by supervisor/heartbeat.
# Example: CONDA_ENV_NAME=env_isaaclab
CONDA_ENV_NAME=env_isaaclab

# Optional explicit activate.bat path if `conda activate` is not found automatically.
# Example: CONDA_ACTIVATE_BAT=C:\Users\etnlw\miniconda3\Scripts\activate.bat
CONDA_ACTIVATE_BAT=

# Training/play defaults.
# Example: TRAIN_ENVS=24576
TRAIN_ENVS=24576
# Example: PLAY_ENVS=50
PLAY_ENVS=50
# Example: MAX_ITERATIONS=15000
MAX_ITERATIONS=15000

# Video/report defaults.
# VIDEO_LENGTH is recorded simulation steps, not seconds.
# Example: VIDEO_LENGTH=250
VIDEO_LENGTH=250
# VIDEO_FPS is the playback fps after report re-encode. Lower values make the clip feel slower/longer.
# Example: VIDEO_FPS=15
VIDEO_FPS=15
# Use headless capture for report/front/rear/top/side video generation.
# Example: VIDEO_CAPTURE_HEADLESS=1
VIDEO_CAPTURE_HEADLESS=1
# If headless capture fails or all views are duplicated, retry once without --headless.
# Example: VIDEO_CAPTURE_FALLBACK_GUI=1
VIDEO_CAPTURE_FALLBACK_GUI=1
# Require distinct video hashes per view (front/rear/top/side/overview). If duplicated, report fails.
# Example: VIDEO_REQUIRE_DISTINCT_VIEWS=1
VIDEO_REQUIRE_DISTINCT_VIEWS=1
# Require metrics/heartbeat_history.xlsx in report ZIP. If export fails, report fails.
# Example: REPORT_REQUIRE_XLSX=1
REPORT_REQUIRE_XLSX=1
# Example: ZIP_FRAME_COUNT=12
ZIP_FRAME_COUNT=12

# Telegram loop timing.
# Example: SUPERVISOR_POLL_SECONDS=10
SUPERVISOR_POLL_SECONDS=10
# Example: HEARTBEAT_POLL_SECONDS=30
HEARTBEAT_POLL_SECONDS=30
# Example: HEARTBEAT_ITER_STEP=100
HEARTBEAT_ITER_STEP=100
